    <!-- 暂停恢复：恢复操作无法解除他人施加的暂停时展示。 -->
    <string name="lz_space_suspend_recovery_title">分身仍被暂停</string>
    <string name="lz_space_suspend_recovery_body">该分身被 %1$s 暂停，Android 只允许暂停者本人解除，应用内恢复对它无效。可以通过 Shizuku/Root 重装分身强制恢复（分身内的数据会被清除），也可以手动卸载后重新克隆。</string>
    <string name="lz_space_suspend_recovery_reinstall">重装分身（清除数据）</string>
    <string name="lz_space_suspend_recovery_cancel">取消</string>
