    <!-- Suspend recovery: shown when a restore could not lift a suspension imposed by someone else. -->
    <string name="lz_space_suspend_recovery_title">Clone still suspended</string>
    <string name="lz_space_suspend_recovery_body">This clone was suspended by %1$s, and Android only lets that same component lift it — in-app restore cannot work here. You can force a recovery by reinstalling the clone via Shizuku/Root (the clone\'s data will be erased), or uninstall it and clone again manually.</string>
    <string name="lz_space_suspend_recovery_reinstall">Reinstall (erase data)</string>
